# Copy this file to `.env` and fill in the values below.
# `.env` is git-ignored — never commit real API keys.

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-xxx

# Main reasoning model (agent loop, tool planning).
ANTHROPIC_MODEL_MAIN=claude-opus-4-8

# Fast model for validation / formatting / cheap classification.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# --- Server ---
PORT=8000
LOG_LEVEL=INFO

# --- Cloud gateway (optional) ---
# Shared secret required as `Authorization: Bearer <token>` on the
# /ws/diagnostic handshake when this engine runs BEHIND wrenchboard-cloud.
# Set it to the SAME value as the cloud's ENGINE_SERVICE_TOKEN so only the
# cloud relay can open diagnostic sessions (a direct websocat is refused,
# can't bypass the cloud's auth/quota and burn credits). Leave EMPTY for the
# standalone workbench — a browser can't set this header, so direct dev runs
# with enforcement off.
ENGINE_SERVICE_TOKEN=

# --- Cloud token metering (optional, T13) ---
# When this engine runs BEHIND wrenchboard-cloud, each diagnostic-agent LLM call
# best-effort reports its raw token usage to the cloud's metering endpoint (the
# cloud prices it per-tenant and keeps the billing ledger). BOTH must be set to
# enable; an unset URL or token makes the report a hard no-op (self-host / dev
# never phones home). The token is the SAME shared secret as ENGINE_SERVICE_TOKEN
# (the cloud validates it as its ENGINE_SERVICE_TOKEN on /internal/* routes).
CLOUD_METERING_URL=
CLOUD_METERING_TOKEN=

# --- Boardview cipher keys (optional — only needed for some encrypted formats) ---
# These are runtime-configurable so the public repository ships only the
# parsing algorithm, never the keys themselves. Aligns with how
# OpenBoardView handles the same formats.
#
# FZ-xor cipher key (44 × uint32 expanded key, 176 bytes hex). Required
# only for .fz files that wrap the FZ-zlib container in the XOR stream
# cipher; plain FZ-zlib files parse without it.
WRENCH_BOARD_FZ_KEY=

# XZZ DES master key (8 bytes hex). Required for encrypted `.pcb` files.
WRENCH_BOARD_XZZ_KEY=
